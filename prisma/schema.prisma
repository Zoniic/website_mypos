generator client {
  provider = "prisma-client-js"
}

/// Admin panel users — replaces the single shared ADMIN_PASSWORD.
/// Bootstrap the first user with: npx tsx prisma/seed-admin-user.ts
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  priceFrom      Int
  os             String
  screenSize     String
  cpu            String
  ram            String
  storage        String
  connectivity   String
  dimensions     String
  weight         String
  warrantyMonths Int
  datasheetUrl   String?
  featured       Boolean  @default(false)
  /// Main product photo (square). Public URL under /uploads/products/.
  imageUrl       String?
  /// Additional gallery photos (side/back/in-use), comma-separated public URLs.
  galleryUrls    String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Optional video (YouTube/Vimeo/Drive link), embedded on the product detail page.
  videoUrl       String?
  /// "in_stock" | "preorder" | "out_of_stock". Free-text (not an enum) to
  /// match this schema's existing convention of plain strings for
  /// admin-editable status fields.
  stockStatus    String   @default("in_stock")
  /// Estimated lead time in days when not in stock. Null when in_stock.
  leadTimeDays   Int?

  translations  ProductTranslation[]
  categories    Category[]
  businessTypes BusinessType[]
  /// Self many-to-many. The app connects both directions on save so the
  /// relation behaves symmetrically (A related to B implies B related to A).
  relatedProducts     Product[] @relation("RelatedProducts")
  relatedProductsBack Product[] @relation("RelatedProducts")
}

/// Product/accessory category (self-order, weigh-pay, pos, ticketing).
/// Replaces the old comma-separated Product.categories/Accessory.categories
/// string columns with a real many-to-many relation.
model Category {
  id       Int         @id @default(autoincrement())
  slug     String      @unique
  products    Product[]
  accessories Accessory[]
}

/// Business type a product suits (restaurant, retail, buffet, ...).
/// Replaces the old comma-separated Product.businessTypes string column.
model BusinessType {
  id       Int       @id @default(autoincrement())
  slug     String    @unique
  products Product[]
}

model ProductTranslation {
  id        Int    @id @default(autoincrement())
  productId Int
  locale    String
  name      String
  highlight String @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model Accessory {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  sortOrder Int      @default(0)
  /// Product photo (square). Public URL under /uploads/accessories/.
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations AccessoryTranslation[]
  categories   Category[]
}

model AccessoryTranslation {
  id          Int    @id @default(autoincrement())
  accessoryId Int
  locale      String
  name        String
  description String @db.Text

  accessory Accessory @relation(fields: [accessoryId], references: [id], onDelete: Cascade)

  @@unique([accessoryId, locale])
}

model ReferenceCase {
  id           Int      @id @default(autoincrement())
  /// Powers the case study detail page URL (/references/[slug]).
  slug         String   @unique
  businessType String
  sortOrder    Int      @default(0)
  /// On-site photo of the installation at the customer's location.
  imageUrl     String?
  /// Customer's own logo, shown as a trust mark on the case study card.
  logoUrl      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  translations ReferenceCaseTranslation[]
}

model ReferenceCaseTranslation {
  id       Int    @id @default(autoincrement())
  caseId   Int
  locale   String
  business String
  problem  String @db.Text
  install  String @db.Text
  result   String @db.Text

  case ReferenceCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, locale])
}

/// Generic key-value store for all marketing copy (hero/about/faq/etc).
/// `key` is a dot-path matching the original messages/*.json structure,
/// e.g. namespace="home", key="hero.title". Arrays/objects (like FAQ items)
/// are stored as a JSON string in `value`.
model PageContent {
  id        Int      @id @default(autoincrement())
  namespace String
  key       String
  locale    String
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([namespace, key, locale])
  @@index([namespace, locale])
}

/// Site-wide settings not tied to a locale: contact info, map, homepage
/// stats. Simple key -> value store, no locale (numbers/links/URLs read
/// the same across languages).
model SiteSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

/// Named image slots used across the site (hero photo, about photos,
/// solution photos, software screenshot, ...). One row per slot; `url` is
/// null until an admin uploads a photo for it.
model SiteImage {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  url       String?
  updatedAt DateTime @updatedAt
}

/// Customer/partner logos shown in the homepage "Trusted by" strip.
model TrustLogo {
  id        Int      @id @default(autoincrement())
  name      String
  imageUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Companies MYPOS is an authorized/official partner of (payment gateways,
/// banks, hardware manufacturers) — shown on the About page. Distinct from
/// TrustLogo, which shows customers who use MYPOS, not partners MYPOS
/// represents.
model OfficialPartner {
  id         Int      @id @default(autoincrement())
  name       String
  imageUrl   String?
  websiteUrl String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Knowledge base category — belongs to one of two top-level sections
/// (hardware / software) shown as separate landing pages.
model KbCategory {
  id        Int      @id @default(autoincrement())
  section   String
  slug      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  translations KbCategoryTranslation[]
  articles     KbArticle[]
}

model KbCategoryTranslation {
  id         Int    @id @default(autoincrement())
  categoryId Int
  locale     String
  name       String

  category KbCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

/// Knowledge base article. `productSlug`/`accessorySlug` are loose text
/// references (matching the Product.relatedSlugs convention elsewhere in
/// this schema) rather than foreign keys, so an article can point at a
/// product/accessory without a hard DB constraint.
model KbArticle {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  categoryId     Int
  productSlug    String?
  accessorySlug  String?
  /// Optional cover photo. Public URL under /uploads/kb/.
  coverImageUrl  String?
  /// Optional downloadable PDF. Public URL under /uploads/kb/.
  pdfUrl         String?
  /// Optional video link (YouTube/Drive) — embedded on the article page.
  videoUrl       String?
  /// Shown in the "Recommended" strip at the top of its section page.
  featured       Boolean  @default(false)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     KbCategory @relation(fields: [categoryId], references: [id])
  translations KbArticleTranslation[]
}

model KbArticleTranslation {
  id        Int    @id @default(autoincrement())
  articleId Int
  locale    String
  title     String
  summary   String @db.Text
  body      String @db.Text

  article KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([locale])
}

/// Blog/news post for organic SEO content (buying guides, announcements),
/// distinct from KbArticle which is customer support documentation.
model BlogPost {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  /// Cover photo. Public URL under /uploads/blog/.
  coverImageUrl String?
  featured      Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  translations BlogPostTranslation[]
}

model BlogPostTranslation {
  id      Int    @id @default(autoincrement())
  postId  Int
  locale  String
  title   String
  excerpt String @db.Text
  body    String @db.Text

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@index([locale])
}

/// Open job posting shown on the careers page. Applications go through the
/// existing contact form (prefilled with the job title), not a separate
/// application-tracking flow.
model JobPosting {
  id             Int      @id @default(autoincrement())
  slug           String   @unique
  department     String
  location       String
  /// "full-time" | "part-time" | "contract" | "internship".
  employmentType String
  isOpen         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  translations JobPostingTranslation[]
}

model JobPostingTranslation {
  id          Int    @id @default(autoincrement())
  jobId       Int
  locale      String
  title       String
  description String @db.Text

  job JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, locale])
}

/// Email captured from the footer newsletter signup. No email-sending
/// integration yet (no ESP API key configured) — this just stores leads
/// for the admin to export/import into whatever ESP is chosen later.
model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}

/// Message submitted from the public /contact page form.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String
  product   String?
  message   String?  @db.Text
  /// "new" | "contacted" | "closed".
  status    String   @default("new")
  createdAt DateTime @default(now())
}

/// A multi-item quote request built from the product comparison/quote cart.
model QuoteRequest {
  id        Int      @id @default(autoincrement())
  name      String
  company   String?
  phone     String
  email     String
  message   String?  @db.Text
  /// "new" | "contacted" | "closed".
  status    String   @default("new")
  createdAt DateTime @default(now())

  items QuoteRequestItem[]
}

model QuoteRequestItem {
  id             Int    @id @default(autoincrement())
  quoteRequestId Int
  productSlug    String
  /// Snapshot of the product name at request time, so the item stays
  /// readable even if the product is later renamed or removed.
  productName    String
  quantity       Int    @default(1)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
}

/// Customer-submitted warranty/RMA claim, reviewed and progressed by an
/// admin (open -> in_progress -> resolved). No customer-facing status
/// tracking page yet — status is admin-only for now.
model WarrantyClaim {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String
  email        String
  productSlug  String?
  serialNumber String?
  issue        String   @db.Text
  /// "open" | "in_progress" | "resolved".
  status       String   @default("open")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
