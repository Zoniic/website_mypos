# Copy this file twice: once to .env (Prisma CLI reads .env, not .env.local)
# and once to .env.local (Next.js app reads .env.local at runtime).
# .env only needs DATABASE_URL; .env.local needs everything below.

# Postgres connection string (Supabase Project Settings > Database >
# Connection string > "Connection pooling", the pgbouncer/6543 one — Vercel's
# serverless functions need the pooled connection, not the direct 5432 one).
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# Supabase project URL and service-role key (Project Settings > API).
# The service-role key bypasses Row Level Security — server-side use only,
# never expose it to the client (no NEXT_PUBLIC_ prefix).
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me"
# Storage bucket name (create it as a *public* bucket in Supabase Storage).
SUPABASE_STORAGE_BUCKET="uploads"

# Admin panel login password (/admin/login). Change this before deploying —
# do not reuse the dev placeholder.
ADMIN_PASSWORD="change-me"

# Random secret used to sign the admin session cookie (jose/HS256).
# Generate one with: openssl rand -base64 32
SESSION_SECRET="change-me-too"

# Optional. GA4 Measurement ID (Google Analytics > Admin > Data Streams,
# looks like "G-XXXXXXXXXX"). Leave unset to disable analytics entirely —
# no tracking script loads without it.
NEXT_PUBLIC_GA_ID=""
